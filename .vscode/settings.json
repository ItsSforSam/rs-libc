{
    "cSpell.words": [
        "auxv",
        "bindgen",
        "bitflags",
        "cfgs",
        "ENOMEM",
        "Errno",
        "globl",
        "libc",
        "MMAP",
        "pthread",
        "pthreads",
        "repr",
        "rslibc",
        "somereason",
        "syscall",
        "syscalls",
        "unistd"
    ],
    "rust-analyzer.check.command": "clippy",
    // "rust-analyzer.cargo.features": ["std"],
    
    // "C_Cpp.default.includePath": ["./include"],
    // https://github.com/bergercookie/asm-lsp#
    "asm-lsp": {
    "command": "asm-lsp",
    "filetypes": [
        "asm", "s", "S"
    ]

},
"json.schemas": [
    {
        "fileMatch": [
            "/custom-targets/*.json",
        ],
        "url": "https://raw.githubusercontent.com/ItsSforSam/rs-libc/refs/heads/main/meta/docs/target-spec-json-schema.json"
    }
]
}
